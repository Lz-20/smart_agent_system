# =============================================================================
# Smart Agent System - 鐜鍙橀噺妯℃澘
# 鐢ㄦ硶锛氬鍒朵负 .env 骞跺～鍏ヤ綘鐨勭湡瀹炲瘑閽?璺緞锛岀粷涓嶈鎶?.env 鎻愪氦鍒?git
# =============================================================================

# ----------------------------- MinerU PDF 瑙ｆ瀽 -------------------------------
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=1
# 妯″瀷鏈湴缂撳瓨鐩綍锛堟寜浣犳満鍣ㄧ殑瀹為檯璺緞淇敼锛?MODELSCOPE_CACHE=D:/ai_models/modelscope_cache
HF_HOME=D:/ai_models/huggingface_cache
MD_ROOT_DIR=./temp-files/

# ----------------------------- 澶фā鍨嬶紙鐧剧偧 DashScope锛?----------------------
# API Key 鐢宠锛歨ttps://bailian.console.aliyun.com/?tab=model#/api-key
LLM_DEFAULT_MODEL=qwen-flash
VL_MODEL=qwen3-vl-flash
OPENAI_API_KEY=your-dashscope-api-key-here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_TEMPERATURE=0.1

# ----------------------------- BGE-M3 宓屽叆妯″瀷 -------------------------------
# 妯″瀷鏈湴璺緞锛堟寜浣犳満鍣ㄧ殑瀹為檯璺緞淇敼锛?BGE_M3_PATH=D:\ai_models\modelscope_cache\models\BAAI\bge-m3
BGE_M3=BAAI/bge-m3
# GPU: cuda:0 / CPU: cpu
BGE_DEVICE=cpu
# CPU 蹇呴』 0锛汫PU 鍙互 1
BGE_FP16=0
ITEM_NAME_DIAG=1

# ----------------------------- Milvus 鍚戦噺鏁版嵁搴?-----------------------------
MILVUS_URL=http://localhost:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names
EMBEDDING_DIM=1024
MILVUS_MINIO_ACCESS_KEY=change-this-minio-access-key
MILVUS_MINIO_SECRET_KEY=change-this-minio-secret-key

# ----------------------------- Neo4j 鐭ヨ瘑鍥捐氨 --------------------------------
# 榛樿璐﹀彿 neo4j锛屽瘑鐮佷笌 docker-compose.yml 涓?NEO4J_AUTH 淇濇寔涓€鑷?NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-this-neo4j-password

# ----------------------------- MongoDB 鑱婂ぉ鍘嗗彶 ------------------------------
# 璐﹀瘑涓?docker-compose.yml 鐨?MONGO_INITDB_ROOT_* 淇濇寔涓€鑷?MONGO_INITDB_ROOT_USERNAME=kbadmin
MONGO_INITDB_ROOT_PASSWORD=change-this-mongo-password
MONGO_URL=mongodb://kbadmin:change-this-mongo-password@localhost:27017/?authSource=admin
MONGO_DB_NAME=kb002

# ----------------------------- MinIO 瀵硅薄瀛樺偍 --------------------------------
# 濡傛灉浣跨敤鏈満 docker-compose 鐨?milvus-minio锛屽彲鏀逛负 localhost:9000锛?# 杩欓噷榛樿鎸囧悜鑷缓 MinIO 鏈嶅姟鍣紝璇锋寜闇€淇敼骞跺姟蹇呮洿鎹㈤粯璁ゅ瘑閽ャ€?MINIO_ENDPOINT=your-minio-host:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=/upload-images
MINIO_SECURE=False

# ----------------------------- BGE Reranker --------------------------------
BGE_RERANKER_LARGE=D:\ai_models\modelscope_cache\models\rerank\BAAI\bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0

# ----------------------------- 鐧剧偧 MCP WebSearch ----------------------------
# 娉ㄦ剰锛氬繀椤讳娇鐢ㄦ柊鐗?Streamable HTTP 鍗忚绔偣 /mcp
# 鏃х増 /sse 鍗忚宸插簾寮冿紝鑰?endpoint 杩斿洖绌哄搷搴斿鑷磋繛鎺ュ紓甯?MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# ----------------------------- MinerU API ----------------------------------
# 鐢宠锛歨ttps://mineru.net/
MINERU_API_TOKEN=your-mineru-jwt-token-here
MINERU_BASE_URL=https://mineru.net/api/v4

# ----------------------------- 鏃ュ織閰嶇疆 ------------------------------------
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=INFO
LOG_FILE_RETENTION=7 days

